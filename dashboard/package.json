{
  "name": "personal-dashboard-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "build": "node scripts/build.mjs",
    "format:check": "prettier --check index.html styles.css app.js modules scripts server api server.mjs eslint.config.js package.json vercel.json",
    "build:vercel": "vercel build --non-interactive"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vercel": "62.1.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "google-auth-library": "^11.1.0"
  }
}
